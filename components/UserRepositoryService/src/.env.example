# Copy this file to .env before running Docker Compose (from Visual Studio or the CLI).
# .env is gitignored - never commit real credentials.
# This copy lives in src/ (alongside docker-compose.yml) because Visual Studio's
# "Docker Compose" startup project resolves variable substitution relative to this folder.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=userdb
MYSQL_USER=userdb_app
MYSQL_PASSWORD=changeme
